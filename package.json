{
	"name": "orangecms",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22.17.0",
		"pnpm": ">=12.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm test:smoke",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"test:smoke": "node scripts/smoke-cms.mjs",
		"mcp:check": "node scripts/mcp-check.mjs",
		"deploy": "pnpm build && wrangler deploy",
		"check:public": "node scripts/audit-public.mjs",
		"test:audit": "node --test scripts/audit-public.test.mjs",
		"test:unit": "node --test scripts/*.test.mjs",
		"test:routes": "node scripts/verify-custom-routes.mjs",
		"test": "pnpm test:unit && pnpm check && pnpm build && pnpm test:routes",
		"db:seed:local": "wrangler d1 execute DB --local --file=seeds/starter.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file=seeds/starter.sql",
		"plugin:package": "node scripts/package-plugin.mjs"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@lucide/svelte": "^1.49.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-bubble-menu": "^3.32.0",
		"@tiptap/extension-typography": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/markdown": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"bits-ui": "^2.19.4",
		"jose": "^6.2.12",
		"marked": "^18.0.14"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261002.1",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource-variable/figtree": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-table": "^9.2.4",
		"@tanstack/table-core": "9.2.4",
		"clsx": "2.1.1",
		"embla-carousel-svelte": "8.6.0",
		"formsnap": "2.0.1",
		"layerchart": "2.5.1",
		"mode-watcher": "1.1.0",
		"paneforge": "1.0.2",
		"runed": "0.37.1",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"svelte-sonner": "1.2.1",
		"svelte-toolbelt": "0.10.6",
		"sveltekit-superforms": "2.31.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.2",
		"wrangler": "4.146.0"
	},
	"license": "MIT"
}
